      <aliases enabled='yes' />
      <column caption='non operational facilities' datatype='integer' name='[Calculation_1134062688214675461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Operational Status] = &apos;not-operational&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='facilities not open 24 hours' datatype='string' name='[Calculation_1134062688214773766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open 24 Hours] = &apos;n&apos; THEN &quot;not open 24 hours&quot; END' />
      </column>
      <column caption='facilities open on weekends' datatype='integer' name='[Calculation_1134062688214872071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Open Weekends] = &apos;y&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='operational facilities' datatype='integer' name='[Calculation_1134062688214966280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Operational Status] = &apos;operational&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='facilities pending opening' datatype='integer' name='[Calculation_1134062688215064585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Operational Status] = &apos;pending-opening&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='bed to population ratio per 1000 people' datatype='real' name='[Calculation_1134062688217919498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Beds]) / SUM([Total Population])) * 1000' />
      </column>
      <column caption='Bed capicity and IPD' datatype='string' name='[Calculation_1373597893419319296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds] = 0 AND [IPD] = &quot;y&quot; THEN &quot;No Beds&quot;&#13;&#10;END' />
      </column>
      <column caption='Operation' datatype='string' name='[Calculation_1373597893424066561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Open 24 Hours] = &apos;y&apos; AND [Open Weekends] = &apos;y&apos; THEN &apos;Open 24 Hours &amp; Weekends&apos;&#13;&#10;ELSEIF [Open 24 Hours] = &apos;y&apos; AND [Open Weekends] = &apos;n&apos; THEN &apos;Open 24 Hours, Closed Weekends&apos;&#13;&#10;ELSEIF [Open 24 Hours] = &apos;n&apos; AND [Open Weekends] = &apos;y&apos; THEN &apos;Does Not Open 24 Hours, Open Weekends&apos;&#13;&#10;ELSE &apos;Does Not Open 24 Hours Nor on Weekends&apos;&#13;&#10;END' />
      </column>
      <column caption='Facility Types' datatype='string' name='[Calculation_2281354706625277952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;hover&quot;' />
      </column>
      <column caption='clean job title' datatype='string' name='[Calculation_2281354707645177860]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Job Title of in Charge]) THEN [Job Title of in Charge] END' />
      </column>
      <column caption='inforamtion' datatype='string' name='[Calculation_2281354707685318665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;i&quot;' />
      </column>
