    <dashboard enable-sort-zone-taborder='true' name='IPD,0 beds'>
      <repository-location id='IPD0beds' path='/workbooks/HealthFacilities_17297773475650' revision='' />
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98002' id='7' param='horz' type-v2='layout-flow' w='98922' x='539' y='999'>
            <zone h='98002' id='5' type-v2='layout-basic' w='81469' x='539' y='999'>
              <zone h='98002' id='3' name='In Patient Facilities with 0 bed capacity' w='81469' x='539' y='999'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='259' h='98002' id='6' is-fixed='true' param='vert' type-v2='layout-flow' w='17453' x='82008' y='999'>
              <zone forceUpdate='true' h='37703' id='8' type-v2='text' w='17453' x='82008' y='999'>
                <formatted-text>
                  <run fontcolor='#555555'>Inpatient care is fundamentally dependent on bed availability. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#555555'>A critical gap in healthcare infrastructure is highlighted by the fact that 65 dispensaries, 42 medical clinics, and 11 health centers offer inpatient services without any bed capacity. This lack of beds undermines the ability of these facilities to provide adequate care, especially for patients requiring overnight or extended stays.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
