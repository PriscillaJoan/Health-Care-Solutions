  <worksheets>
    <worksheet name='Distribution of Hospital Beds'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>Distribution of Hospital Beds per 1000 people</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/HealthFacilities_17297773475650/107516555?rev=' id='DistributionofHospitalBeds' path='/workbooks/HealthFacilities_17297773475650' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='facilities_data (2)' name='federated.0xbf17i19wbp3g11tm49g0wlm9r3' />
          </datasources>
          <datasource-dependencies datasource='federated.0xbf17i19wbp3g11tm49g0wlm9r3'>
            <column datatype='integer' name='[Beds]' role='measure' type='quantitative' />
            <column caption='bed to population ratio per 1000 people' datatype='real' name='[Calculation_1134062688217919498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Beds]) / SUM([Total Population])) * 1000' />
            </column>
            <column datatype='string' name='[Constituencies]' role='dimension' type='nominal' />
